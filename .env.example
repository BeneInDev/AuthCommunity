# Server-only Supabase credentials. Never place real values in this example.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Independent signing secret (at least 32 characters), shared by all instances.
# Required for private OAuth. Only the legacy flow supports fallback to CLIENT_SECRET.
OAUTH_STATE_SECRET=
# Private OAuth repository (read only when the opt-in flow is enabled).
# JSON object: key identifiers mapped to independent 32-byte base64url keys.
# Generate/manage outside the database. No real key belongs in this file.
OAUTH_TOKEN_KEYS=
OAUTH_TOKEN_ACTIVE_KEY_ID=

# New OAuth consent flow: opt-in only after migrations and staging validation.
OAUTH_PRIVATE_ENABLED=false
OAUTH_CONSENT_DAYS=30
# Requires OAUTH_PRIVATE_ENABLED=true and migrations 001-004. Disabled by default.
OAUTH_MEMBER_JOIN_ENABLED=false
# Per-guild verification/configuration/effects. Requires private OAuth and migrations 001-005.
OAUTH_MULTIGUILD_ENABLED=false
